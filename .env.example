# 渡口 · 本地环境变量
# 复制成 .env 再填。这个文件不要提交，也不要贴到群里。
#
# AI_MOCK=1 → 全部走假数据（默认，任何人 clone 下来都能跑）
# AI_MOCK=0 → 走真模型，三条链路各自读自己的 *_BASE_URL/*_API_KEY/*_MODEL
AI_MOCK=1

# ---- 文案（OpenAI 兼容接口，DeepSeek 最省） ----
TEXT_BASE_URL=https://api.deepseek.com/v1
TEXT_API_KEY=
TEXT_MODEL=deepseek-chat

# ---- 出图（硅基流动 Flux / Kolors；也可换任意 OpenAI 兼容出图服务） ----
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_API_KEY=
IMAGE_MODEL=doubao-seedream-4-0-250828

# ---- 语音识别（视频字幕第一段：先把人声转成文字） ----
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# ---- 商品短视频（Seedance / 火山方舟 Ark，异步任务 1–3 分钟） ----
# 注意：Seedance 是视频生成，不是出图；出图仍走 IMAGE_*
VIDEO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIDEO_API_KEY=
VIDEO_MODEL=doubao-seedance-1-0-lite-i2v-250428

# Seedream 说明：与 Seedance 同一把 ARK key，IMAGE_/VIDEO_ 可以填同一个
# 4.0 支持传入 image 参数做图生图（我们的精修图/三视图参考就靠它）；3.0 只支持文生图
